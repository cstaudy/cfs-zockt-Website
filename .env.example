# cfs_zockt Creator Suite — runtime example
# Keine echten Secrets committen.

NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-domain.example
# Optional: WebAuthn RP-ID ohne https://. Standardmäßig wird der Host aus APP_BASE_URL verwendet.
CFS_WEBAUTHN_RP_ID=
# Zusätzliche erlaubte Hostnamen, kommasepariert (z. B. Staging/Operations).
CFS_ALLOWED_HOSTS=
# HSTS Subdomains/Preload erst aktivieren, wenn ALLE Subdomains dauerhaft HTTPS können.
CFS_HSTS_INCLUDE_SUBDOMAINS=false
CFS_HSTS_PRELOAD=false
DATABASE_URL=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/auth/tiktok/callback

CFS_TOKEN_ENCRYPTION_KEY=
# Eigenständiges Production-Secret (mind. 32 Zeichen); ohne dieses startet Production nicht.
CFS_CSRF_SIGNING_SECRET=
# Eigenständiger HMAC-Schlüssel (mind. 32 Zeichen) für datensparsame Review-Missbrauchserkennung.
CFS_PUBLIC_REVIEW_HASH_SALT=
# Eigenständiger HMAC-Schlüssel (mind. 32 Zeichen) für öffentliche Support-/Security-Meldungen.
CFS_PUBLIC_SUPPORT_HASH_SALT=
# Eigenständiger HMAC-Schlüssel (mind. 32 Zeichen) für gehashte MFA-Recovery-Codes.
CFS_MFA_RECOVERY_HASH_SALT=
# Eigenständiges Signing-Secret (mind. 32 Zeichen) für kurzlebige Admin-Step-up-Tokens.
CFS_ADMIN_ELEVATION_SECRET=
# Eigenständiger HMAC-Schlüssel (mind. 32 Zeichen) für die manipulationssichtbare Admin-Audit-Kette.
CFS_ADMIN_AUDIT_HMAC_SECRET=

# Optionaler unabhängiger Backup-Schlüssel (mind. 32 Zeichen).
# Wird nur von den DB-Backup-/Restore-Tools verwendet, nicht vom laufenden Webserver.
CFS_BACKUP_ENCRYPTION_KEY=

# Account-Mail-Unterbau: standardmäßig deaktiviert.
# webhook = signierter HTTPS-Relay; ohne vollständige Konfiguration bleibt Recovery aus.
CFS_ACCOUNT_MAIL_MODE=disabled
CFS_ACCOUNT_MAIL_WEBHOOK_URL=
CFS_ACCOUNT_MAIL_WEBHOOK_SECRET=
# Gilt für NEU registrierte Accounts. Bestehende aktive Accounts werden nicht rückwirkend gesperrt.
CFS_EMAIL_VERIFICATION_REQUIRED=false
CFS_ADMIN_CREATOR_IDS=
CFS_ADMIN_EMAILS=
CFS_LAUNCHER_BUILD_TARGET_VERSION=0.42.0
CFS_RELEASE_EVIDENCE_VERSION=0.42.0
CFS_LAUNCHER_RELEASE_REPO=cstaudy/CFS-TikTok-Backend
CFS_GITHUB_RELEASE_TOKEN=

CFS_STRIPE_SECRET_KEY=
CFS_STRIPE_WEBHOOK_SECRET=
CFS_STRIPE_PRICE_CREATOR_MONTHLY=
CFS_STRIPE_PRICE_PRO_MONTHLY=
CFS_BILLING_GRACE_DAYS=3

# Legacy *_VERIFIED Flags absichtlich nicht hier setzen.
# V38+ Evidence und V39+ Acceptance verwenden.

# Nur für Migration/Notfall; normalerweise NICHT aktivieren:
CFS_ALLOW_LEGACY_VERIFICATION_FLAGS=false
