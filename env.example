# cfs_zockt Creator Suite — runtime example
# GitHub-safe example file.
# KEINE echten Secrets hier eintragen oder committen.

NODE_ENV=production
PORT=3000
APP_BASE_URL=https://cfs-zockt.de

# WebAuthn / Hosts
CFS_WEBAUTHN_RP_ID=cfs-zockt.de
CFS_ALLOWED_HOSTS=cfs-zockt.de,www.cfs-zockt.de
CFS_HSTS_INCLUDE_SUBDOMAINS=false
CFS_HSTS_PRELOAD=false

# Database
DATABASE_URL=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://cfs-zockt.de/auth/tiktok/callback

# Security
CFS_TOKEN_ENCRYPTION_KEY=
CFS_CSRF_SIGNING_SECRET=
CFS_PUBLIC_REVIEW_HASH_SALT=
CFS_PUBLIC_SUPPORT_HASH_SALT=
CFS_MFA_RECOVERY_HASH_SALT=
CFS_ADMIN_ELEVATION_SECRET=
CFS_ADMIN_AUDIT_HMAC_SECRET=
CFS_BACKUP_ENCRYPTION_KEY=

# Admin
CFS_ADMIN_EMAILS=cstaudygaming@googlemail.com

# Account mail
CFS_ACCOUNT_MAIL_MODE=disabled
CFS_ACCOUNT_MAIL_WEBHOOK_URL=
CFS_ACCOUNT_MAIL_WEBHOOK_SECRET=
CFS_EMAIL_VERIFICATION_REQUIRED=false

# Provider / commercial mode
CFS_PROVIDER_BETA_REQUIRED=true
CFS_PROVIDER_BETA_PROVIDERS=tiktok,twitch
CFS_COMMERCIAL_MODE=false

# Launcher / release
CFS_LAUNCHER_BUILD_TARGET_VERSION=0.47.30
CFS_PUBLIC_TWITCH_PROFILE_URL=https://www.twitch.tv/cfs_zockt
CFS_PUBLIC_TWITCH_LIVE_CACHE_TTL_MS=12000
CFS_RELEASE_EVIDENCE_VERSION=0.47.30
CFS_LAUNCHER_RELEASE_REPO=cstaudy/CFS-TikTok-Backend
CFS_GITHUB_RELEASE_TOKEN=

# Stripe
CFS_STRIPE_SECRET_KEY=
CFS_STRIPE_WEBHOOK_SECRET=
CFS_STRIPE_PRICE_CREATOR_MONTHLY=
CFS_STRIPE_PRICE_PRO_MONTHLY=
CFS_BILLING_GRACE_DAYS=3

# Legacy verification flags normally disabled
CFS_ALLOW_LEGACY_VERIFICATION_FLAGS=false

# CFS AI v196 Integration (Root/Admin only)
# In Production/Render: CFS_AI_ENABLED=true und CFS_AI_TRANSPORT=bridge
CFS_AI_ENABLED=false
CFS_AI_BASE_URL=http://127.0.0.1:8000
CFS_AI_BRIDGE_TOKEN=
CFS_AI_TIMEOUT_MS=110000
CFS_AI_TRANSPORT=direct
CFS_AI_BRIDGE_LEASE_SECONDS=180
