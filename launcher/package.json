  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.cfszockt.creator-suite.launcher",
    "productName": "cfs_zockt Creator Suite",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "cfs_zockt-Creator-Suite-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "cfs_zockt Creator Suite",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "cfs_zockt-Creator-Suite-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cstaudy",
        "repo": "CFS-TikTok-Backend",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "portable": {
      "artifactName": "cfs_zockt-Creator-Suite-Portable-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "tiktok-live-api": "1.4.9",
    "electron-updater": "6.6.2"
  }
}
