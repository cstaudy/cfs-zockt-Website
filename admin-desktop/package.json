{
  "name": "cfs-admin-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "CFS Admin Desktop für cfs-zockt.de",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.cfszockt.admin",
    "productName": "CFS Admin",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "CFS-Admin-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CFS Admin",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
